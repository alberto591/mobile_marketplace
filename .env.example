# Mobile Marketplace - Environment Configuration Template
# Copy this file to .env.local for local development or set these variables in your hosting environment.
# DO NOT commit real secrets or credentials to version control.

# Eurodesguace Málaga API (Backend / Edge Functions)
EURODESGUACE_BASE_URL=https://eurodesguacemalaga.com/api/v1
EURODESGUACE_API_KEY=your_eurodesguace_api_key_here

# Supabase Staging / Production Backend Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SYNC_ADMIN_SECRET=your_custom_sync_admin_secret_here

# Mobile App Client Configuration (Expo Public Variables)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Options: 'mock' (default for local UI development) or 'backend' (connects to Supabase public_catalog_parts)
EXPO_PUBLIC_CATALOG_DATA_SOURCE=mock
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Connect (Edge Functions & Staging)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
# Minutes a checkout holds its parts reserved while the buyer pays (5-120, default 30)
RESERVATION_TTL_MINUTES=30

# Transactional Email Notifications (Resend - Edge Function: submit-inquiry)
RESEND_API_KEY=re_your_resend_api_key_here
INQUIRY_FROM_EMAIL=consultas@yourdomain.com
EURODESGUACE_INQUIRY_EMAIL=ventas@eurodesguace-example.com
INQUIRY_EMAIL_TEST_MODE=false
INQUIRY_TEST_RECIPIENT_EMAIL=

# Order paid emails (Edge Function: stripe-webhook) — to the buyer and to the seller
# From address: ORDER_FROM_EMAIL, falling back to INQUIRY_FROM_EMAIL
ORDER_FROM_EMAIL=pedidos@yourdomain.com
# Test mode is ON unless this is exactly 'false': every email goes to ORDER_TEST_RECIPIENT_EMAIL
# (falling back to INQUIRY_TEST_RECIPIENT_EMAIL) instead of real buyers and sellers.
ORDER_EMAIL_TEST_MODE=true
ORDER_TEST_RECIPIENT_EMAIL=
# Seller address used when the vendor has no public_email (falls back to EURODESGUACE_INQUIRY_EMAIL)
ORDER_SELLER_FALLBACK_EMAIL=
# Public URL of the web app (expo export -p web) that hosts the seller page /vendor/order.
# When set, the seller's "order paid" email includes a "Marcar como enviado" button.
VENDOR_PORTAL_BASE_URL=https://app.yourdomain.com
# Inbox that is emailed when a payment needs a person: a part charged twice or an amount
# that does not match the order (stripe-webhook "REVISIÓN MANUAL").
OPS_ALERT_EMAIL=
