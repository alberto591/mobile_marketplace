# Mobile Marketplace - Environment Configuration Template
# Copy this file to .env.local for local development or set these variables in your hosting environment.
# DO NOT commit real secrets or credentials to version control.

# Eurodesguace Málaga API (Backend / Edge Functions)
EURODESGUACE_BASE_URL=https://eurodesguacemalaga.com/api/v1
EURODESGUACE_API_KEY=your_eurodesguace_api_key_here

# Supabase Staging / Production Backend Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SYNC_ADMIN_SECRET=your_custom_sync_admin_secret_here

# Mobile App Client Configuration (Expo Public Variables)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Options: 'mock' (default for local UI development) or 'backend' (connects to Supabase public_catalog_parts)
EXPO_PUBLIC_CATALOG_DATA_SOURCE=mock
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Connect (Edge Functions & Staging)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
