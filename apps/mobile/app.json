{
  "expo": {
    "name": "Buscapiezas 24h",
    "slug": "mobile-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "recambios",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buscapiezas24h.recambios",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B0C0F"
      },
      "package": "com.buscapiezas24h.recambios"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0F"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.buscapiezas24h.recambios",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "96e98b7a-6789-438a-b82b-80d07164e645"
      }
    },
    "owner": "albertocalvorivas"
  }
}
