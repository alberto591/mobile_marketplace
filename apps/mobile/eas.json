{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CATALOG_DATA_SOURCE": "backend"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_CATALOG_DATA_SOURCE": "backend"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_CATALOG_DATA_SOURCE": "backend"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "PENDIENTE_APPLE_ID",
        "ascAppId": "PENDIENTE_ASC_APP_ID",
        "appleTeamId": "PENDIENTE_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
