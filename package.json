{
  "name": "mobile-marketplace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace de recambios usados de desguace - Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @mobile-marketplace/core",
    "postinstall": "npm run build:core",
    "pretest": "npm run build:core",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live -w @mobile-marketplace/mobile",
    "pretypecheck": "npm run build:core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.14",
    "lightningcss-darwin-arm64": "^1.33.0"
  }
}
